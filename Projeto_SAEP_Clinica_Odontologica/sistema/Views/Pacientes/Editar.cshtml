@model ClinicaOdontologica.Models.Paciente
<h2>Editar paciente</h2>@if(ViewBag.Erro!=null){<div class="alert alert-danger">@ViewBag.Erro</div>}
<form method="post">@Html.AntiForgeryToken()<div class="mb-3"><label>Nome</label><input name="nome" value="@Model.Nome" class="form-control" required /></div><div class="mb-3"><label>CPF</label><input name="cpf" value="@ViewBag.Cpf" class="form-control" required /></div><div class="mb-3"><label>Telefone</label><input name="telefone" value="@Model.Telefone" class="form-control" required /></div><button class="btn btn-primary">Salvar alteração</button> <a href="/Pacientes">Cancelar</a></form>