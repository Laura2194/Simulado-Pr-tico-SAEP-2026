<h2>Novo procedimento</h2>@if(ViewBag.Erro!=null){<div class="alert alert-danger">@ViewBag.Erro</div>}
<form method="post">@Html.AntiForgeryToken()<div class="mb-3"><label>Nome</label><input name="nome" class="form-control" required /></div><div class="mb-3"><label>Descrição</label><input name="descricao" class="form-control" /></div><div class="mb-3"><label>Valor</label><input name="valor" type="number" step="0.01" min="0" class="form-control" required /></div><button class="btn btn-primary">Salvar</button> <a href="/Procedimentos">Cancelar</a></form>